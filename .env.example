GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY=fake_private_key
GITHUB_APP_INSTALLATION_ID=654321
GITHUB_WEBHOOK_SECRET=fake_webhook_secret
BOT_NAME=PatchGuard-AI

# ── Distributed Cluster Configuration ────────────────────────────────────────
# Port used by the WebSocket cluster server on every node.
# All nodes in a cluster must use the same CLUSTER_PORT.
# Default: 3001
CLUSTER_PORT=3001

# GPU memory (GB) that this node contributes to the cluster.
# The coordinator uses this value to proportionally assign model layers.
# Default: 8
NODE_GPU_MEMORY_GB=8

# Port on which the local Ollama instance is reachable.
# Default: 11434
NODE_OLLAMA_PORT=11434

# RPC port that this node exposes so the coordinator's Ollama can offload model
# layers to it.  Required for distributed inference of large models (e.g.
# qwen3-coder:480b).  Set the same value on every worker node.
# Must be non-zero on worker nodes for model splitting to work.
# Default: 0 (disabled – node does not expose an RPC endpoint)
NODE_OLLAMA_RPC_PORT=12434

# Set to "true" on the COORDINATOR node to have the agent manage the Ollama
# subprocess automatically.  When enabled, the agent spawns `ollama serve`
# with OLLAMA_RPC_SERVERS updated each time a worker joins or leaves, so
# model layers are redistributed across the cluster without manual restarts.
# Default: false
OLLAMA_MANAGE=false

# Path to the `ollama` binary.  Only used when OLLAMA_MANAGE=true.
# Default: ollama (assumes it is on PATH)
OLLAMA_BIN=ollama

# Optional: explicitly set the WebSocket URL (or host:port) of the coordinator.
# When set, this node skips LAN discovery and connects directly as a worker.
# Leave unset on the primary/coordinator node.
# Example: COORDINATOR_HOST=192.168.1.10:3001
COORDINATOR_HOST=